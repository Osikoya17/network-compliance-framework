<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ project_title }} — Compliance Report</title>
<style>
  :root {
    --bg: #ffffff;
    --text: #1a1a1a;
    --text-secondary: #5a5a5a;
    --border: #d8d8d8;
    --border-strong: #b8b8b8;
    --pass: #2f6f4e;
    --pass-bg: #eef4f0;
    --sev-critical: #8b2e2e;
    --sev-high: #a85c2e;
    --sev-medium: #8a7530;
    --sev-low: #6b6b6b;
    --font-sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }

  main {
    max-width: 920px;
    margin: 0 auto;
    padding: 56px 24px 96px;
  }

  header.report-header {
    border-bottom: 1px solid var(--border);
    padding-bottom: 28px;
    margin-bottom: 36px;
  }

  header.report-header h1 {
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 6px;
  }

  header.report-header p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 14px;
  }

  header.report-header p.scope {
    margin-top: 4px;
  }

  section { margin-bottom: 44px; }

  section > h2 {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-secondary);
    margin: 0 0 16px;
    text-transform: none;
  }

  /* Overview stats */
  .stat-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--border);
  }
  .stat-cell {
    padding: 18px 20px;
    border-right: 1px solid var(--border);
  }
  .stat-cell:last-child { border-right: none; }
  .stat-cell .value {
    font-size: 28px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }
  .stat-cell .label {
    color: var(--text-secondary);
    font-size: 13px;
    margin-top: 6px;
  }
  .band-good { color: var(--pass); }
  .band-mid { color: var(--sev-medium); }
  .band-poor { color: var(--sev-critical); }

  /* Device score bars */
  .bar-row {
    display: grid;
    grid-template-columns: 160px 1fr 64px;
    align-items: center;
    gap: 14px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }
  .bar-row:first-child { border-top: 1px solid var(--border); }
  .bar-row .device-name {
    font-family: var(--font-mono);
    font-size: 13.5px;
  }
  .bar-track {
    height: 10px;
    border: 1px solid var(--border-strong);
    background: #fafafa;
    position: relative;
  }
  .bar-fill { height: 100%; }
  .bar-fill.bar-good { background: var(--pass); }
  .bar-fill.bar-mid { background: var(--sev-medium); }
  .bar-fill.bar-poor { background: var(--sev-critical); }
  .bar-row .device-score {
    font-variant-numeric: tabular-nums;
    text-align: right;
    font-size: 13.5px;
  }

  /* Filter controls */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    border: 1px solid var(--border);
    padding: 12px 14px;
  }
  .filters input[type="search"] {
    flex: 1;
    min-width: 180px;
    border: 1px solid var(--border-strong);
    padding: 7px 10px;
    font-family: var(--font-sans);
    font-size: 13.5px;
    color: var(--text);
    background: #fff;
  }
  .filters input[type="search"]:focus,
  .sev-toggle:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 1px;
  }
  .sev-toggle {
    font-family: var(--font-sans);
    font-size: 13px;
    padding: 6px 10px;
    background: #fff;
    border: 1px solid var(--border-strong);
    color: var(--text-secondary);
    cursor: pointer;
  }
  .sev-toggle[aria-pressed="true"] {
    color: #fff;
    border-color: var(--text);
    background: var(--text);
  }
  .filters .count {
    color: var(--text-secondary);
    font-size: 13px;
    margin-left: auto;
  }

  /* Device detail blocks */
  details.device {
    border: 1px solid var(--border);
    margin-bottom: -1px;
  }
  details.device summary {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: baseline;
    gap: 16px;
    padding: 14px 16px;
    cursor: pointer;
  }
  details.device summary::-webkit-details-marker { display: none; }
  details.device summary .device-name {
    font-family: var(--font-mono);
    font-size: 14.5px;
    font-weight: 600;
  }
  details.device summary .device-score {
    font-variant-numeric: tabular-nums;
    font-size: 14px;
  }
  details.device summary .device-tally {
    color: var(--text-secondary);
    font-size: 13px;
  }
  details.device[open] summary { border-bottom: 1px solid var(--border); }

  table.checks {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
  }
  table.checks th {
    text-align: left;
    font-weight: 600;
    color: var(--text-secondary);
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    font-size: 12.5px;
  }
  table.checks td {
    padding: 9px 14px;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  table.checks tr:last-child td { border-bottom: none; }
  table.checks td.rule { max-width: 260px; }
  table.checks td.interface,
  table.checks td.expected,
  table.checks td.actual {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--text-secondary);
    white-space: nowrap;
  }
  table.checks tr.fail td.rule { border-left: 3px solid var(--row-sev, var(--sev-high)); padding-left: 11px; }
  table.checks tr.pass td.rule { border-left: 3px solid transparent; padding-left: 11px; }

  .status-badge {
    font-size: 12px;
    font-weight: 600;
  }
  .status-badge.pass { color: var(--pass); }
  .status-badge.fail { color: var(--row-sev, var(--sev-high)); }

  .sev-label {
    font-size: 12px;
    color: var(--text-secondary);
  }

  tr[data-hidden="true"] { display: none; }

  footer {
    margin-top: 56px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 12.5px;
  }

  @media print {
    details.device { break-inside: avoid; }
  }
</style>
</head>
<body>
<main>

  <header class="report-header">
    <h1>{{ project_title }}</h1>
    <p>Compliance scan — {{ generated_at }}</p>
    <p class="scope">{{ device_count }} devices scanned · {{ total_checks }} checks evaluated</p>
  </header>

  <section class="overview">
    <div class="stat-row">
      <div class="stat-cell">
        <div class="value {{ overall_band }}">{{ overall_score }}%</div>
        <div class="label">Overall network score</div>
      </div>
      <div class="stat-cell">
        <div class="value">{{ device_count }}</div>
        <div class="label">Devices scanned</div>
      </div>
      <div class="stat-cell">
        <div class="value">{{ pass_count }}</div>
        <div class="label">Checks passed</div>
      </div>
      <div class="stat-cell">
        <div class="value {{ 'band-poor' if fail_count > 0 else '' }}">{{ fail_count }}</div>
        <div class="label">Checks failed</div>
      </div>
    </div>
  </section>

  <section>
    <h2>Score by device</h2>
    {% for d in devices %}
    <div class="bar-row">
      <div class="device-name">{{ d.name }}</div>
      <div class="bar-track">
        <div class="bar-fill {{ d.band_bg }}" style="width: {{ d.score }}%;"></div>
      </div>
      <div class="device-score">{{ d.score }}%</div>
    </div>
    {% endfor %}
  </section>

  <section>
    <h2>Filter checks</h2>
    <div class="filters" id="filters">
      <input type="search" id="search-box" placeholder="Search rule, interface, device…" aria-label="Search checks">
      <button class="sev-toggle" data-filter="status" data-value="fail" aria-pressed="false">Failing only</button>
      <button class="sev-toggle" data-filter="severity" data-value="CRITICAL" aria-pressed="false">Critical</button>
      <button class="sev-toggle" data-filter="severity" data-value="HIGH" aria-pressed="false">High</button>
      <button class="sev-toggle" data-filter="severity" data-value="MEDIUM" aria-pressed="false">Medium</button>
      <button class="sev-toggle" data-filter="severity" data-value="LOW" aria-pressed="false">Low</button>
      <span class="count" id="visible-count"></span>
    </div>
  </section>

  <section class="devices">
    <h2>Results by device</h2>
    {% for d in devices %}
    <details class="device" open>
      <summary>
        <span class="device-name">{{ d.name }}</span>
        <span class="device-tally">{{ d.pass_count }} passed · {{ d.fail_count }} failed</span>
        <span class="device-score {{ d.band_text }}">{{ d.score }}%</span>
      </summary>
      <table class="checks" data-device="{{ d.name }}">
        <thead>
          <tr>
            <th>Rule</th>
            <th>Interface</th>
            <th>Status</th>
            <th>Expected</th>
            <th>Actual</th>
            <th>Severity</th>
          </tr>
        </thead>
        <tbody>
          {% for r in d.results %}
          <tr class="{{ 'fail' if r.status == 'FAIL' else 'pass' }}"
              style="{{ '--row-sev: ' ~ r.sev_color ~ ';' if r.status == 'FAIL' else '' }}"
              data-status="{{ r.status|lower }}"
              data-severity="{{ r.severity }}"
              data-search="{{ (r.rule ~ ' ' ~ (r.interface or '') ~ ' ' ~ d.name)|lower }}">
            <td class="rule">{{ r.rule }}</td>
            <td class="interface">{{ r.interface or '—' }}</td>
            <td><span class="status-badge {{ r.status|lower }}">{{ '✓ pass' if r.status == 'PASS' else '✗ fail' }}</span></td>
            <td class="expected">{{ r.expected }}</td>
            <td class="actual">{{ r.actual }}</td>
            <td><span class="sev-label">{{ r.severity }}</span></td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </details>
    {% endfor %}
  </section>

  <footer>
    Generated by the compliance framework's report module · data collected via {{ collection_summary }}
  </footer>

</main>

<script>
(function () {
  var searchBox = document.getElementById('search-box');
  var toggles = document.querySelectorAll('.sev-toggle');
  var rows = document.querySelectorAll('table.checks tbody tr');
  var visibleCountEl = document.getElementById('visible-count');

  var state = { search: '', statusFail: false, severities: new Set() };

  function apply() {
    var visible = 0;
    rows.forEach(function (row) {
      var matchesSearch = !state.search || row.getAttribute('data-search').indexOf(state.search) !== -1;
      var matchesStatus = !state.statusFail || row.getAttribute('data-status') === 'fail';
      var matchesSeverity = state.severities.size === 0 || state.severities.has(row.getAttribute('data-severity'));
      var show = matchesSearch && matchesStatus && matchesSeverity;
      row.setAttribute('data-hidden', show ? 'false' : 'true');
      if (show) visible++;
    });
    visibleCountEl.textContent = visible + ' of ' + rows.length + ' checks shown';
  }

  searchBox.addEventListener('input', function (e) {
    state.search = e.target.value.trim().toLowerCase();
    apply();
  });

  toggles.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var filter = btn.getAttribute('data-filter');
      var value = btn.getAttribute('data-value');
      if (filter === 'status') {
        state.statusFail = !state.statusFail;
        btn.setAttribute('aria-pressed', state.statusFail ? 'true' : 'false');
      } else {
        if (state.severities.has(value)) {
          state.severities.delete(value);
          btn.setAttribute('aria-pressed', 'false');
        } else {
          state.severities.add(value);
          btn.setAttribute('aria-pressed', 'true');
        }
      }
      apply();
    });
  });

  apply();
})();
</script>
</body>
</html>
