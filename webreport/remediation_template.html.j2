<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ device_name }} — Remediation Cycle</title>
<style>
  :root {
    --bg: #ffffff;
    --text: #1a1a1a;
    --text-secondary: #5a5a5a;
    --border: #d8d8d8;
    --border-strong: #b8b8b8;
    --pass: #2f6f4e;
    --sev-critical: #8b2e2e;
    --sev-high: #a85c2e;
    --sev-medium: #8a7530;
    --sev-low: #6b6b6b;
    --font-sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--text);
    font-family: var(--font-sans); font-size: 15px; line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  main { max-width: 920px; margin: 0 auto; padding: 56px 24px 96px; }
  header.report-header { border-bottom: 1px solid var(--border); padding-bottom: 28px; margin-bottom: 36px; }
  header.report-header h1 { font-size: 24px; font-weight: 600; letter-spacing: -0.01em; margin: 0 0 6px; font-family: var(--font-mono); }
  header.report-header p { margin: 0; color: var(--text-secondary); font-size: 14px; }
  header.report-header p.scope { margin-top: 4px; }

  section { margin-bottom: 44px; }
  section > h2 { font-size: 13px; font-weight: 600; color: var(--text-secondary); margin: 0 0 16px; }

  .transition-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr 1fr;
    align-items: center;
    border: 1px solid var(--border);
  }
  .transition-cell { padding: 20px; border-right: 1px solid var(--border); }
  .transition-cell:last-child { border-right: none; }
  .transition-cell .value { font-size: 30px; font-weight: 600; font-variant-numeric: tabular-nums; line-height: 1.1; }
  .transition-cell .label { color: var(--text-secondary); font-size: 13px; margin-top: 6px; }
  .transition-arrow { display: flex; align-items: center; justify-content: center; padding: 0 8px; color: var(--text-secondary); font-size: 20px; }
  .band-good { color: var(--pass); }
  .band-mid { color: var(--sev-medium); }
  .band-poor { color: var(--sev-critical); }

  table.transitions { width: 100%; border-collapse: collapse; font-size: 13.5px; border: 1px solid var(--border); }
  table.transitions th {
    text-align: left; font-weight: 600; color: var(--text-secondary);
    padding: 10px 14px; border-bottom: 1px solid var(--border); font-size: 12.5px;
  }
  table.transitions td { padding: 9px 14px; border-bottom: 1px solid var(--border); vertical-align: top; }
  table.transitions tr:last-child td { border-bottom: none; }
  table.transitions td.interface { font-family: var(--font-mono); font-size: 12.5px; color: var(--text-secondary); white-space: nowrap; }
  .status-badge { font-size: 12px; font-weight: 600; }
  .status-badge.pass { color: var(--pass); }
  .status-badge.fail { color: var(--row-sev, var(--sev-high)); }
  .sev-label { font-size: 12px; color: var(--text-secondary); }
  .arrow-cell { color: var(--text-secondary); text-align: center; width: 28px; }

  .note-line { color: var(--text-secondary); font-size: 13.5px; padding: 12px 0; border-top: 1px solid var(--border); }

  footer { margin-top: 56px; padding-top: 20px; border-top: 1px solid var(--border); color: var(--text-secondary); font-size: 12.5px; }
</style>
</head>
<body>
<main>

  <header class="report-header">
    <h1>{{ device_name }}</h1>
    <p>Remediation cycle — {{ generated_at }}</p>
    <p class="scope">Collection method: {{ method }}</p>
  </header>

  <section>
    <div class="transition-row">
      <div class="transition-cell">
        <div class="value {{ before_band }}">{{ before_score }}%</div>
        <div class="label">Before</div>
      </div>
      <div class="transition-arrow">→</div>
      <div class="transition-cell">
        <div class="value {{ after_band }}">{{ after_score }}%</div>
        <div class="label">After</div>
      </div>
      <div class="transition-cell">
        <div class="value">{{ resolved|length }}</div>
        <div class="label">Violations resolved</div>
      </div>
    </div>
  </section>

  {% if resolved %}
  <section>
    <h2>Resolved</h2>
    <table class="transitions">
      <thead>
        <tr><th>Rule</th><th>Interface</th><th>Before</th><th></th><th>After</th><th>Severity</th></tr>
      </thead>
      <tbody>
        {% for r in resolved %}
        <tr style="--row-sev: {{ r.sev_color }};">
          <td>{{ r.rule }}</td>
          <td class="interface">{{ r.interface or '—' }}</td>
          <td><span class="status-badge fail">✗ fail</span></td>
          <td class="arrow-cell">→</td>
          <td><span class="status-badge pass">✓ pass</span></td>
          <td><span class="sev-label">{{ r.severity }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  {% if still_failing %}
  <section>
    <h2>Still failing</h2>
    <table class="transitions">
      <thead>
        <tr><th>Rule</th><th>Interface</th><th>Before</th><th></th><th>After</th><th>Severity</th></tr>
      </thead>
      <tbody>
        {% for r in still_failing %}
        <tr style="--row-sev: {{ r.sev_color }};">
          <td>{{ r.rule }}</td>
          <td class="interface">{{ r.interface or '—' }}</td>
          <td><span class="status-badge fail">✗ fail</span></td>
          <td class="arrow-cell">→</td>
          <td><span class="status-badge fail">✗ fail</span></td>
          <td><span class="sev-label">{{ r.severity }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    <p class="note-line">No automated remediation template was available or applicable for these — they need a manual fix.</p>
  </section>
  {% endif %}

  <p class="note-line">{{ already_compliant_count }} check(s) were already passing before this cycle and are not listed above.</p>

  <footer>
    Generated by the compliance framework's report module
  </footer>

</main>
</body>
</html>
